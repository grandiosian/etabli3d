      "descripteur": "Chemin de ce fichier : \"centrale.json\".",
      "activites()": "Liste envoyée à la Centrale : [{id, titre, groupe, total}].",
      "catalogue()": "Catalogue détaillé (champs de activites.liste).",
      "progression(id)": "{titre, faites, total, statut} ou null si l’activité n’a jamais été ouverte.",
      "fusionnerProgression(serveur)": "Fusionne le résultat de Centrale.mesProgressions().",
      "donnees()": "{projet} : valeurs des clés enregistrées.",
      "estProjet(objet)": "true si l’objet est un projet chargeable.",
      "ouvrirProjet(objet)": "Ouvre un projet ; l’ancien reste accessible avec Annuler.",
      "resume()": "Résumé calculé (format Resume).",
      "fichier(nom)": "Promise<Blob|null> : le fichier produit d’après l’extension du nom (.json projet, resume.json, .stl, .png)."
    }
