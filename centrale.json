  "progression": {
    "envoi": "Centrale.progression(id, Etabli3D.progression(id))",
    "quand": [
      "ouverture d’un tuto, d’un exercice ou d’un exemple (faites = 0)",
      "tuto ou exercice : chaque nouvelle étape ou critère réussi (vérifiés automatiquement deux fois par seconde)",
      "activité terminée (statut = termine) : toutes les étapes d’un tuto, tous les critères d’un exercice, toutes les cases « À essayer » d’un exemple"
    ],
    "champs": {
      "titre": "titre de l’activité",
      "faites": "tuto / exercice : meilleur nombre d’étapes ou de critères réussis ; exemple : 0 tant qu’il n’est pas terminé, puis total",
      "total": "nombre d’étapes (tuto), de critères (exercice) ou de cases « À essayer » (exemple)",
      "statut": "commence | termine"
    },
    "champs_non_utilises": [
      "score",
      "score_max",
      "details"
    ],
    "a_la_connexion": "Établi 3D lit mesProgressions(), garde le meilleur entre le navigateur et le serveur (Etabli3D.fusionnerProgression), puis renvoie les activités où le navigateur est en avance.",
    "format": {
      "$ref": "#/$defs/Progression"
    }
  },
  "donnees": {
    "projet": {
      "description": "Le projet en cours : pièces, matières et images, liaisons, structure, fiche d’exemple et consignes du TP. Même contenu que Fichier → Enregistrer le projet (.json).",
      "sauvegarde": "À chaque modification enregistrée dans l’historique (y compris Annuler / Rétablir) ; la Centrale regroupe les envois (3 s au plus).",
      "chargement": "À la connexion : si le serveur a un projet différent, il remplace celui du navigateur (l’ancien reste accessible avec Annuler). Sinon le projet du navigateur est envoyé.",
      "taille_typique": "5 à 60 Ko ; jusqu’à quelques centaines de Ko avec des images de matière (512 px max chacune). Limite de la Centrale : 2 Mo par clé.",
      "format": {
        "$ref": "#/$defs/Projet"
      }
    }
  },
  "fichiers": {
    "utilises": true,
    "convention": "recoit et produit : listes de { nom, type, description }. Établi 3D reconnaît un fichier à son extension : les noms sont des motifs (* = n’importe quel nom), le professeur nomme les fichiers de l’étape comme il veut (ex. support-telephone.json, support.stl). Le nom conseillé est indiqué dans « nom_conseille ».",
    "recoit": [
      {
        "nom": "*.json",
        "nom_conseille": "projet.etabli3d.json",
        "type": "application/json",
        "description": "Projet de départ (format Projet). Ouvert en arrivant dans l’étape (si l’élève n’y a rien déposé), ou par Fichier → Reprendre le fichier de l’atelier. Un .json qui n’est pas un projet Établi 3D est ignoré."
      }
    ],
    "produit": [
      {
        "nom": "*.json",
        "nom_conseille": "projet.etabli3d.json",
        "type": "application/json",
        "description": "Le projet de l’élève (format Projet). Sauf resume.json."
      },
      {
        "nom": "resume.json",
        "nom_conseille": "resume.json",
        "type": "application/json",
        "description": "Résumé calculé : pièces, tailles, volumes, matières, masses, liaisons (format Resume). Pour un tableur, un questionnaire ou une fiche de fabrication. Le nom doit finir par resume.json."
      },
      {
        "nom": "*.stl",
        "nom_conseille": "piece.stl",
        "type": "model/stl",
        "description": "Maillage binaire en mm des pièces solides visibles, pour l’impression 3D (perçages déjà retirés)."
      },
      {
        "nom": "*.png",
        "nom_conseille": "apercu.png",
        "type": "image/png",
        "description": "Image de la vue 3D (640 px de large)."
      }
    ],
    "depot": "Automatique avant « Étape suivante » et « ← Mes ateliers » (avantDeQuitter), ou Fichier → Déposer dans le dossier de l’atelier : chaque nom de sortie de l’étape est produit d’après son extension, puis Centrale.projet.sauver(nom, blob).",
    "fichiers_eleve": "Fichier → Envoyer le STL au professeur : Centrale.envoyerFichier(stl, Centrale.nomFichier('stl', nom du projet)).",
    "dossier_projet": true
  },
  "stockage_local": {
    "description": "Copies dans le navigateur de l’élève, utilisées sans connexion ou quand la Centrale est injoignable.",
    "cles": {
      "etabli3d.autosave": {
        "contenu": "projet courant",
        "format": {
          "$ref": "#/$defs/Projet"
        }
      },
      "etabli3d.progress": {
        "contenu": "avancement : done[« tuto:clé » | « exo:clé » | « ex:clé »] = date, seen[…] = 1, part[clé] = étapes réussies",
        "format": {
          "$ref": "#/$defs/ProgressionLocale"
        }
      },
      "etabli3d.prefs": {
        "contenu": "préférences d’affichage du poste (niveau, thème, rendu…) ; jamais envoyées à la Centrale"
      },
      "etabli3d.layout": {
        "contenu": "position des panneaux ; jamais envoyée à la Centrale"
      }
    }
  },
  "acces_javascript": {
