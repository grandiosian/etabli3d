  "$defs": {
    "Activite": {
      "type": "object",
      "required": [
        "id",
        "titre",
        "groupe",
        "total"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(tuto|exo|ex)-[A-Za-z0-9]+$"
        },
        "titre": {
          "type": "string"
        },
        "groupe": {
          "type": "string"
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Progression": {
      "type": "object",
      "required": [
        "faites",
        "total",
        "statut"
      ],
      "properties": {
        "titre": {
          "type": "string"
        },
        "faites": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "statut": {
          "enum": [
            "commence",
            "termine"
          ]
        }
      }
    },
    "ProgressionLocale": {
      "type": "object",
      "properties": {
        "done": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "seen": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "part": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "Resume": {
      "type": "object",
      "properties": {
        "nom": {
          "type": "string"
        },
        "unites": {
          "type": "object"
        },
        "pieces": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "nom": {
                "type": "string"
              },
              "forme": {
                "type": "string"
              },
              "percage": {
                "type": "boolean"
              },
              "matiere": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "taille": {
                "type": [
                  "array",
                  "null"
                ],
                "description": "X, Y, Z en mm"
              },
              "volume": {
                "type": "number",
                "description": "cm³"
              },
              "masse": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "g, si la matière est connue"
              },
              "validation": {
                "enum": [
                  "none",
                  "stale",
                  "ok",
                  "warn",
                  "err"
                ]
              }
            }
          }
        },
        "liaisons": {
          "type": "array"
        },
        "totaux": {
          "type": "object"
        }
      }
    },
    "Projet": {
      "description": "Projet Établi 3D (clé de données « projet », même contenu que Fichier → Enregistrer). Unités : mm, degrés, N, MPa. Z vers le haut. Les champs inconnus doivent être conservés.",
      "type": "object",
      "required": [
        "parts"
      ],
      "properties": {
        "app": {
          "const": "etabli3d"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Version du format du projet. 1 : d'origine. 2 : ajoute part.mat et textures."
        },
        "name": {
          "type": "string",
          "description": "Nom du projet"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Piece"
          },
          "description": "Pièces de premier niveau, dans l'ordre de création"
        },
        "joints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Liaison"
          },
          "default": []
        },
        "nextId": {
          "type": "integer",
          "minimum": 1,
          "description": "Prochain identifiant libre, partagé par pièces, liaisons et enfants de groupes"
        },
        "note": {
          "$ref": "#/$defs/Fiche"
        },
        "tp": {
          "$ref": "#/$defs/ConsignesTP"
        },
        "struct": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Structure"
            }
          ]
        },
        "textures": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "description": "Images de matière utilisées par les pièces (part.mat.k = 'image'), clé = identifiant",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "src"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "src": {
                    "type": "string",
                    "pattern": "^data:image/",
                    "description": "Image en data URL (JPEG ≤ 512 px conseillé)"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "Vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "Couleur": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "Piece": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "pos",
        "rot"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "box",
            "cylinder",
            "sphere",
            "cone",
            "pyramid",
            "wedge",
            "tube",
            "torus",
            "text",
            "gear",
            "rack",
            "sketch",
            "group"
          ]
        },
        "name": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "description": "Cotes de la forme en mm : voir enums.formes"
        },
        "color": {
          "$ref": "#/$defs/Couleur"
        },
        "hole": {
          "type": "boolean",
          "description": "true : perçage, retire la matière des solides du même groupe"
        },
        "pos": {
          "$ref": "#/$defs/Vec3",
          "description": "Position de l'origine de la pièce (base, centre) dans le repère du parent, mm"
        },
        "rot": {
          "$ref": "#/$defs/Vec3",
          "description": "Rotation en degrés, angles d'Euler ordre XYZ"
        },
        "mat": {
          "$ref": "#/$defs/Matiere"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Piece"
          },
          "description": "Seulement pour kind = group ; positions relatives au groupe"
        },
        "hidden": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "inGroup": {
          "type": "integer",
          "description": "Interne : mode édition d'un groupe"
        },
        "valid": {
          "type": "object",
          "description": "Résultat de la validation : {key, level: ok|warn|err, tris, proxy, issues[]}. Recalculé par l'app : à conserver, ne pas produire."
        },
        "locs": {
          "type": "array",
          "description": "Repères (locators) en coordonnées de la pièce : {id, name, kind: centre|base|axe|face, pos, dir, auto}"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "group"
              }
            }
          },
          "then": {
            "required": [
              "children"
            ]
          }
        }
      ]
    },
    "Matiere": {
      "type": "object",
      "required": [
        "k"
      ],
      "properties": {
        "k": {
          "enum": [
            "pla",
            "bois",
            "mdf",
            "carton",
            "acier",
            "alu",
            "laiton",
            "plexi",
            "caoutchouc",
            "beton",
            "pierre",
            "image"
          ]
        },
        "img": {
          "type": "string",
          "description": "Si k = image : clé dans textures"
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Si k = image : côté du motif en mm (projection sur trois plans)"
        }
      }
    },
    "Esquisse": {
      "type": "object",
      "description": "Esquisse 2D dans le plan (u, v) choisi. Contour extérieur dans le sens trigonométrique, trous dans le sens horaire.",
      "properties": {
        "nid": {
          "type": "integer"
        },
        "pts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "x",
              "y"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "fixed": {
                "type": "boolean"
              },
              "origin": {
                "type": "boolean"
              },
              "it": {
                "enum": [
                  "lin",
                  "auto",
                  "bez"
                ]
              },
              "tm": {
                "enum": [
                  "sym",
                  "align",
                  "free"
                ]
              }
            }
          }
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "a",
              "b"
            ]
          }
        },
        "circles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "c",
              "r"
            ]
          }
        },
        "beziers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "a",
              "b",
              "t1",
              "t2"
            ],
            "description": "t1 : poignée au départ a, t2 : à l'arrivée b, relatives"
          }
        },
        "cons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "dist",
                  "dx",
                  "dy",
                  "diam",
                  "h",
                  "v",
                  "par",
                  "perp",
                  "eq",
                  "eqr"
                ]
              },
              "value": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "Liaison": {
      "type": "object",
      "required": [
        "id",
        "type",
        "child"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "fixe",
            "pivot",
            "glissiere"
          ]
        },
        "child": {
          "type": "integer",
          "description": "Pièce mobile (une seule liaison par pièce mobile)"
        },
        "parent": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Support ; null = le bâti (plan de travail)"
        },
        "origin": {
          "$ref": "#/$defs/Vec3",
          "description": "Point de l'axe, repère du support, mm"
        },
        "axis": {
          "$ref": "#/$defs/Vec3",
          "description": "Direction unitaire de l'axe, repère du support"
        },
        "min": {
          "type": [
            "number",
            "null"
          ],
          "description": "Butée basse (° ou mm)"
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "motor": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "continu",
                    "alternatif"
                  ]
                },
                "speed": {
                  "type": "number",
                  "description": "°/s ou mm/s"
                }
              }
            }
          ]
        },
        "driver": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "joint": {
                  "type": "integer"
                },
                "ratio": {
                  "type": "number"
                }
              }
            }
          ],
          "description": "Transmission : mouvement = ratio × mouvement de la liaison menante"
        },
        "loc": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "pid": {
                  "type": "integer"
                },
                "lid": {
                  "type": "string"
                }
              }
            }
          ],
          "description": "Repère auquel l'axe est accroché"
        }
      }
    },
    "Fiche": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "observe": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "try": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "description": "Fiche d'exemple (HTML simple autorisé : b, i, span.kbd)"
        }
      ]
    },
    "ConsignesTP": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "tasks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "t"
                ],
                "properties": {
                  "t": {
                    "type": "string"
                  },
                  "done": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          "description": "Consignes du professeur, cochées par l'élève"
        }
      ]
    },
    "Structure": {
      "type": "object",
      "description": "Atelier Structures. Plan vertical (x horizontal, y vertical), mm / N / MPa.",
      "properties": {
        "mod": {
          "enum": [
            "treillis",
            "maillage"
          ]
        },
        "truss": {
          "type": "object",
          "properties": {
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "x",
                  "y"
                ],
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "sup": {
                    "enum": [
                      null,
                      "fixe",
                      "glissant"
                    ]
                  },
                  "fx": {
                    "type": "number"
                  },
                  "fy": {
                    "type": "number"
                  }
                }
              }
            },
            "bars": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "a",
                  "b"
                ],
                "properties": {
                  "sec": {
                    "enum": [
                      "plein",
                      "tube",
                      "cable"
                    ]
                  },
                  "D": {
                    "type": "number"
                  },
                  "d": {
                    "type": "number"
                  },
                  "mat": {
                    "enum": [
                      "bois",
                      "acier",
                      "alu",
                      "pla",
                      "pierre",
                      "beton"
                    ]
                  }
                }
              }
            },
            "nid": {
              "type": "integer"
            },
            "mat": {
              "type": "string"
            },
            "sec": {
              "type": "string"
            },
            "D": {
              "type": "number"
            },
            "d": {
              "type": "number"
            },
            "grav": {
              "type": "boolean"
            },
            "labels": {
              "type": "boolean"
            }
          }
        },
        "mesh": {
          "type": "object",
          "description": "Maillage : forme (poutre, arc…), cotes P, épaisseur t, matériau, appuis (encastre, appuis, pieds), charge, F en N"
        }
      }
    }
  }
}
