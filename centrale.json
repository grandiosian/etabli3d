{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandiosian.github.io/etabli3d/centrale.json",
  "format": "passerelle.atelier",
  "version": 1,
  "atelier": {
    "app": "etabli3d",
    "nom": "Établi 3D",
    "version": "1.1.0",
    "description": "Modeleur 3D pour la technologie : volumes, perçages, esquisses cotées, matières, liaisons et simulation de mouvements, structures, export STL pour l’impression 3D.",
    "url": "https://grandiosian.github.io/etabli3d/",
    "urls_secours": [],
    "icone": "🧊",
    "depot": "https://github.com/grandiosian/etabli3d",
    "langue": "fr",
    "classes": [
      "5e",
      "4e",
      "3e"
    ],
    "_correspondance": "Champs de la table ateliers de la Centrale : app, nom, description, url, icone, urls_secours."
  },
  "centrale": {
    "module": "js/centrale-client.js",
    "serveur_par_defaut": "https://technoversailles.alwaysdata.net/",
    "changer_de_serveur": "window.CENTRALE_URL = \"https://…/\" avant le chargement de la page.",
    "sites_a_autoriser": [
      "https://grandiosian.github.io"
    ],
    "chargement": "Le module est chargé à la fin du démarrage. S’il est injoignable, Établi 3D fonctionne seul (enregistrement dans le navigateur).",
    "connexion": {
      "bouton": "« Mon code » dans la barre du haut, avant Guide ; une fois connecté, il affiche « classe · élève » et permet de se déconnecter.",
      "depuis_le_portail": "Jeton dans l’adresse (#centrale=…) : connexion automatique.",
      "activite_directe": "Centrale.activiteDemandee() renvoie un id d’activité (ex. tuto-premiers, exo-de, ex-maison) : Établi 3D ouvre le tuto, l’exercice ou l’exemple, sauf si l’élève est déjà dessus.",
      "retour": "Bouton « ← Mes ateliers » ajouté par le module."
    },
    "parcours": {
      "bouton_suivant": "module",
      "avant_de_quitter": "Dépose dans le dossier de projet chaque sortie de l’étape (produite d’après son extension : .json projet, resume.json, .stl, .png), si le projet a changé depuis le dernier dépôt. Rien hors atelier.",
      "arrivee": "Ouvre le projet de l’étape : le .json déjà déposé par l’élève ou son équipe (sorties), sinon le .json reçu (entrées) ; garde le projet en cours s’il est plus récent que ce dépôt. Le projet précédent reste dans Annuler."
    },
    "fonctions_utilisees": [
      "init",
      "afficherConnexion",
      "connecte",
      "session",
      "deconnexion",
      "charger",
      "sauver",
      "listeDonnees",
      "progression",
      "mesProgressions",
      "activiteDemandee",
      "envoyerFichier",
      "nomFichier",
      "contexteAtelier",
      "etape",
      "projet.charger",
      "projet.sauver"
    ],
    "fonctions_non_utilisees": [
      "listeFichiers",
      "chargerFichier",
      "supprimerFichier",
      "listeRessources",
      "chargerRessource",
      "parcours",
      "ateliers",
      "lien",
      "ouvrir",
      "telecharger",
      "ouvrirDepot"
    ]
