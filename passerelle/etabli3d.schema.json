{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandiosian.github.io/etabli3d/passerelle/etabli3d.schema.json",
  "title": "Projet Établi 3D (etabli3d.project, format 2)",
  "description": "Document échangé entre Établi 3D et une application centralisatrice. Unités : mm, degrés, N, MPa. Z vers le haut. Les champs inconnus doivent être conservés tels quels par le centralisateur.",
  "type": "object",
  "required": ["parts"],
  "properties": {
    "app": { "const": "etabli3d" },
    "version": { "type": "integer", "minimum": 1, "description": "Version du format. 1 : d'origine. 2 : ajoute part.mat et textures." },
    "name": { "type": "string", "description": "Nom du projet" },
    "parts": { "type": "array", "items": { "$ref": "#/$defs/part" }, "description": "Pièces de premier niveau, dans l'ordre de création" },
    "joints": { "type": "array", "items": { "$ref": "#/$defs/joint" }, "default": [] },
    "nextId": { "type": "integer", "minimum": 1, "description": "Prochain identifiant libre, partagé par pièces, liaisons et enfants de groupes" },
    "note": { "$ref": "#/$defs/note" },
    "tp": { "$ref": "#/$defs/tp" },
    "struct": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/struct" }] },
    "textures": {
      "oneOf": [{ "type": "null" }, {
        "type": "object",
        "description": "Images de matière utilisées par les pièces (part.mat.k = 'image'), clé = identifiant",
        "additionalProperties": {
          "type": "object", "required": ["src"],
          "properties": { "name": { "type": "string" }, "src": { "type": "string", "pattern": "^data:image/", "description": "Image en data URL (JPEG ≤ 512 px conseillé)" } }
        }
      }]
    }
  },
  "$defs": {
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "part": {
      "type": "object",
      "required": ["id", "kind", "pos", "rot"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["box", "cylinder", "sphere", "cone", "pyramid", "wedge", "tube", "torus", "text", "gear", "rack", "sketch", "group"] },
        "name": { "type": "string" },
        "params": { "type": "object", "description": "Cotes de la forme, en mm (voir $defs/params)" },
        "color": { "$ref": "#/$defs/color" },
        "hole": { "type": "boolean", "description": "true : perçage, retire la matière des solides du même groupe" },
        "pos": { "$ref": "#/$defs/vec3", "description": "Position de l'origine de la pièce (base, centre) dans le repère du parent, mm" },
        "rot": { "$ref": "#/$defs/vec3", "description": "Rotation en degrés, angles d'Euler ordre XYZ" },
        "mat": { "$ref": "#/$defs/material" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/part" }, "description": "Seulement pour kind = group ; positions relatives au groupe" },
        "hidden": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "inGroup": { "type": "integer", "description": "Interne : mode édition d'un groupe" },
        "valid": { "type": "object", "description": "Résultat de la validation : {key, level: ok|warn|err, tris, proxy, issues[]}. Recalculé par l'app : à conserver, ne pas produire." },
        "locs": { "type": "array", "description": "Repères (locators) en coordonnées de la pièce : {id, name, kind: centre|base|axe|face, pos, dir, auto}" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "group" } } }, "then": { "required": ["children"] } }
      ]
    },
    "material": {
      "type": "object",
      "required": ["k"],
      "properties": {
        "k": { "enum": ["pla", "bois", "mdf", "carton", "acier", "alu", "laiton", "plexi", "caoutchouc", "beton", "pierre", "image"] },
        "img": { "type": "string", "description": "Si k = image : clé dans textures" },
        "size": { "type": "number", "exclusiveMinimum": 0, "description": "Si k = image : côté du motif en mm (projection sur trois plans)" }
      }
    },
    "params": {
      "description": "Paramètres par forme (mm sauf mention)",
      "box": { "L": "longueur X", "l": "largeur Y", "h": "hauteur Z" },
      "cylinder": { "d": "diamètre", "h": "hauteur", "seg": "facettes" },
      "sphere": { "d": "diamètre", "seg": "facettes" },
      "cone": { "d": "diamètre de base", "d2": "diamètre du haut", "h": "hauteur", "seg": "facettes" },
      "pyramid": { "L": "X", "l": "Y", "h": "Z" },
      "wedge": { "L": "X", "l": "Y", "h": "Z" },
      "tube": { "d": "diamètre extérieur", "di": "diamètre intérieur", "h": "hauteur", "seg": "facettes" },
      "torus": { "d": "diamètre moyen", "e": "épaisseur", "seg": "facettes" },
      "text": { "txt": "texte (40 car.)", "size": "hauteur des lettres", "h": "épaisseur", "font": "sans|serif|mono|round" },
      "gear": { "z": "nombre de dents", "m": "module", "e": "épaisseur", "dh": "diamètre d'alésage" },
      "rack": { "n": "nombre de dents", "m": "module", "e": "épaisseur", "hb": "hauteur sous les dents" },
      "sketch": { "sk": "dessin (voir $defs/sketch)", "mode": "extrude|revolve", "h": "hauteur d'extrusion", "plane": "xy|xz|yz" }
    },
    "sketch": {
      "type": "object",
      "description": "Esquisse 2D dans le plan (u, v) choisi. Contour extérieur dans le sens trigonométrique, trous dans le sens horaire.",
      "properties": {
        "nid": { "type": "integer" },
        "pts": { "type": "array", "items": { "type": "object", "required": ["id", "x", "y"], "properties": { "id": { "type": "integer" }, "x": { "type": "number" }, "y": { "type": "number" }, "fixed": { "type": "boolean" }, "origin": { "type": "boolean" }, "it": { "enum": ["lin", "auto", "bez"] }, "tm": { "enum": ["sym", "align", "free"] } } } },
        "lines": { "type": "array", "items": { "type": "object", "required": ["id", "a", "b"] } },
        "circles": { "type": "array", "items": { "type": "object", "required": ["id", "c", "r"] } },
        "beziers": { "type": "array", "items": { "type": "object", "required": ["id", "a", "b", "t1", "t2"], "description": "t1 : poignée au départ a, t2 : à l'arrivée b, relatives" } },
        "cons": { "type": "array", "items": { "type": "object", "required": ["id", "type"], "properties": { "type": { "enum": ["dist", "dx", "dy", "diam", "h", "v", "par", "perp", "eq", "eqr"] }, "value": { "type": "number" } } } }
      }
    },
    "joint": {
      "type": "object",
      "required": ["id", "type", "child"],
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "type": { "enum": ["fixe", "pivot", "glissiere"] },
        "child": { "type": "integer", "description": "Pièce mobile (une seule liaison par pièce mobile)" },
        "parent": { "type": ["integer", "null"], "description": "Support ; null = le bâti (plan de travail)" },
        "origin": { "$ref": "#/$defs/vec3", "description": "Point de l'axe, repère du support, mm" },
        "axis": { "$ref": "#/$defs/vec3", "description": "Direction unitaire de l'axe, repère du support" },
        "min": { "type": ["number", "null"], "description": "Butée basse (° ou mm)" },
        "max": { "type": ["number", "null"] },
        "motor": { "oneOf": [{ "type": "null" }, { "type": "object", "properties": { "mode": { "enum": ["continu", "alternatif"] }, "speed": { "type": "number", "description": "°/s ou mm/s" } } }] },
        "driver": { "oneOf": [{ "type": "null" }, { "type": "object", "properties": { "joint": { "type": "integer" }, "ratio": { "type": "number" } } }], "description": "Transmission : mouvement = ratio × mouvement de la liaison menante" },
        "loc": { "oneOf": [{ "type": "null" }, { "type": "object", "properties": { "pid": { "type": "integer" }, "lid": { "type": "string" } } }], "description": "Repère auquel l'axe est accroché" }
      }
    },
    "note": {
      "oneOf": [{ "type": "null" }, { "type": "object", "properties": { "observe": { "type": "array", "items": { "type": "string" } }, "try": { "type": "array", "items": { "type": "string" } } }, "description": "Fiche d'exemple (HTML simple autorisé : b, i, span.kbd)" }]
    },
    "tp": {
      "oneOf": [{ "type": "null" }, { "type": "object", "properties": { "title": { "type": "string" }, "tasks": { "type": "array", "items": { "type": "object", "required": ["t"], "properties": { "t": { "type": "string" }, "done": { "type": "boolean" } } } } }, "description": "Consignes du professeur, cochées par l'élève" }]
    },
    "struct": {
      "type": "object",
      "description": "Atelier Structures. Plan vertical (x horizontal, y vertical), mm / N / MPa.",
      "properties": {
        "mod": { "enum": ["treillis", "maillage"] },
        "truss": {
          "type": "object",
          "properties": {
            "nodes": { "type": "array", "items": { "type": "object", "required": ["id", "x", "y"], "properties": { "id": { "type": "integer" }, "x": { "type": "number" }, "y": { "type": "number" }, "sup": { "enum": [null, "fixe", "glissant"] }, "fx": { "type": "number" }, "fy": { "type": "number" } } } },
            "bars": { "type": "array", "items": { "type": "object", "required": ["id", "a", "b"], "properties": { "sec": { "enum": ["plein", "tube", "cable"] }, "D": { "type": "number" }, "d": { "type": "number" }, "mat": { "enum": ["bois", "acier", "alu", "pla", "pierre", "beton"] } } } },
            "nid": { "type": "integer" }, "mat": { "type": "string" }, "sec": { "type": "string" }, "D": { "type": "number" }, "d": { "type": "number" }, "grav": { "type": "boolean" }, "labels": { "type": "boolean" }
          }
        },
        "mesh": { "type": "object", "description": "Maillage : forme (poutre, arc…), cotes P, épaisseur t, matériau, appuis (encastre, appuis, pieds), charge, F en N" }
      }
    }
  }
}
